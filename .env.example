# Medisoft 2.0 web app - environment variables.
# Copy this file to ".env" (local) or add the same names in your host's settings (e.g. Vercel).
# A blank value counts as "not set". Never commit ".env" and never put real values in this file.

# The API's address, no trailing slash (e.g. https://api.example.com). The web app's server forwards
# every browser call under /api to it, so the browser itself never needs this address.
# Default for local work: http://localhost:5000.
# NEXT_PUBLIC_ means this value IS included in the browser files - do not put anything secret here.
NEXT_PUBLIC_API_URL=

# Optional. A long random value (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
# Sent to the API on every call as the x-proxy-key header so the API can refuse anyone else.
# Must be the SAME value as PROXY_SHARED_SECRET on the API. Server-side only: it must NOT start with
# NEXT_PUBLIC_, and it never reaches the browser. Set it here first, then on the API.
PROXY_SHARED_SECRET=
